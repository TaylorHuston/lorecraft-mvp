{
  "name": "lorecraft-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "CONVEX_AGENT_MODE=anonymous convex dev --start \"next dev --webpack\"",
    "dev:debug": "CONVEX_AGENT_MODE=anonymous LORECRAFT_DEBUG_LOG=1 LORECRAFT_DEBUG_LOG_RAW_REQUEST=1 LORECRAFT_DEBUG_LOG_RAW_LLM=1 LORECRAFT_DEBUG_STORE_RAW_REQUEST=1 convex dev --start \"next dev --webpack\"",
    "dev:next": "next dev --webpack",
    "dev:next:turbopack": "next dev",
    "dev:convex": "convex dev",
    "convex:once": "CONVEX_AGENT_MODE=anonymous convex dev --once",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "ci:required": "npm run lint && npm run test && npm run typecheck && npm run build",
    "playtest:director": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/director-playtest.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "benchmark:director-models": "node scripts/director-model-benchmark.mjs",
    "playtest:director:transcript": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/director-transcript-playtest.mjs",
    "playtest:director:persistenceless": "npm run playtest:director:transcript"
  },
  "dependencies": {
    "convex": "^1.42.0",
    "next": "16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
